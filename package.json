{
  "name": "delb",
  "private": true,
  "type": "module",
  "version": "0.1.3",
  "scripts": {
    "build": "pnpm --filter @delb/epub build && nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "prepare:nuxt": "nuxt prepare",
    "typecheck": "pnpm --filter @delb/epub typecheck && nuxt typecheck",
    "test:epub": "pnpm --filter @delb/epub test",
    "test:cover-transaction": "node --import tsx --test server/utils/books/cover-update-transaction.test.ts",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx",
    "postinstall": "sh -c 'if [ \"${NUXT_PREPARE:-}\" = \"1\" ] || [ \"${NUXT_PREPARE:-}\" = \"true\" ]; then nuxt prepare; else echo \"Skipping nuxt prepare (set NUXT_PREPARE=1 to enable)\"; fi'",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:migrateprod": "npx tsx .drizzle/migrate.ts",
    "db:studio": "npx -y -p esbuild@0.25.12 -p drizzle-kit@0.31.8 drizzle-kit studio",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch",
    "release:major": "standard-version --release-as major",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "dependencies": {
    "@delb/epub": "workspace:*",
    "@libsql/client": "^0.15.15",
    "@libsql/darwin-arm64": "^0.5.29",
    "@libsql/linux-arm64-gnu": "^0.5.29",
    "@nuxt/fonts": "0.12.1",
    "@nuxt/icon": "2.1.1",
    "@pinia/nuxt": "^0.11.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/vue-3": "^3.31.4",
    "@vueuse/nuxt": "^14.4.0",
    "better-auth": "^1.7.7",
    "canvas-confetti": "^1.9.4",
    "drizzle-orm": "^0.45.3",
    "epub2": "^3.0.2",
    "epubjs": "^0.3.93",
    "esbuild": "0.27.2",
    "fuzzysort": "^3.1.0",
    "nuxt": "^4.6.0",
    "pdfreader": "^3.0.8",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pino": "^10.4.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "uuid": "^13.0.2"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.141",
    "@nuxt/eslint": "1.12.1",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "standard-version": "^9.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vue-tsc": "^2.2.12"
  }
}
