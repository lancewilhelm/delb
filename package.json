{
  "name": "delb",
  "private": true,
  "type": "module",
  "version": "0.1.3",
  "scripts": {
    "build:web": "vite build",
    "build": "pnpm build:web && pnpm go:build",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 3001",
    "preview": "vite preview",
    "docs:check": "node scripts/check-docs.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test:page-sort": "node --import tsx --test app/stores/ui.pages.test.ts",
    "test:theme": "node --import tsx --test app/utils/customTheme.test.ts app/utils/themePreference.test.ts app/stores/userSettings.customTheme.test.ts",
    "test:reader-fullscreen": "node --import tsx --test app/utils/readerFullscreen.test.ts",
    "test:cover-upload": "node --import tsx --test app/utils/coverUpload.test.ts",
    "test": "node scripts/test.mjs",
    "test:integration": "node review/run-api-regressions.mjs",
    "go:build": "CGO_ENABLED=0 go build -trimpath -ldflags=\"-s -w\" -o bin/delb ./cmd/delb",
    "go:test": "go test -count=1 ./...",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch",
    "release:major": "standard-version --release-as major"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.2.5",
    "@fontsource/geist": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/inter": "^5.2.5",
    "@fontsource/montserrat": "^5.2.5",
    "@fontsource/noto-serif": "^5.2.5",
    "@fontsource/nunito": "^5.2.5",
    "@fontsource/poppins": "^5.2.5",
    "@fontsource/pt-serif": "^5.2.5",
    "@fontsource/roboto-mono": "^5.2.5",
    "@iconify/vue": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/vue-3": "^3.31.4",
    "@vueuse/core": "^14.4.0",
    "canvas-confetti": "^1.9.4",
    "epubjs": "^0.3.93",
    "fuzzysort": "^3.1.0",
    "ofetch": "^1.5.1",
    "pdfjs-dist": "6.5.438",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "tailwindcss": "^4.3.3",
    "uuid": "^13.0.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@iconify-json/lucide": "^1.2.141",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/server-renderer": "^3.5.44",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^14.0.0",
    "prettier": "^3.9.9",
    "standard-version": "^9.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^8.3.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
